{
  "name": "@tmx-group/audit-verifier",
  "version": "2.0.0",
  "description": "Standalone, zero-dependency verifier for Thea API hash-chained audit receipts. Independently confirms an answer happened and has not been altered — no trust in the API required.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js",
      "require": "./dist/verify.cjs"
    }
  },
  "main": "./dist/verify.cjs",
  "types": "./dist/verify.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "gen:spec": "cp ../thea-api/packages/audit-verifier/SPEC.md SPEC.md",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmx-group/thea-audit-verifier.git"
  },
  "homepage": "https://github.com/tmx-group/thea-audit-verifier#readme",
  "bugs": {
    "url": "https://github.com/tmx-group/thea-audit-verifier/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "audit",
    "hash-chain",
    "verifier",
    "tamper-evident",
    "receipt",
    "thea",
    "typescript"
  ]
}
